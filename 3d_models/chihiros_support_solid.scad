// =========================================================
// RECONSTRUÇÃO MANUAL (LADO A LADO)
// Transladado em Y=+100 para não sobrepor com a original!
// =========================================================

    // VARIÁVEIS MATEMÁTICAS GLOBAIS (Alinhamento perfeito)
    // Travando o eixo Y da parede traseira no Ponto 2
    Y_TRASEIRO = meus_pontos[2][1];
    ESPESSURA = 5.0;
    Y_FRONTAL = Y_TRASEIRO - ESPESSURA;
    LARGURA_BRACO = meus_pontos[110][0] - meus_pontos[6][0]; // 50.0mm exatos!



    // =========================================================
    // MÓDULO DO BRAÇO (Permite duplicar para o lado direito)
    // =========================================================
    module braco(hole_x) {
        difference() {
            union() {
                // 2. Base Laranja
                color("darkorange", alpha=0.8)
                translate([0, Y_FRONTAL, meus_pontos[1][2]]) 
                    cube([
                        LARGURA_BRACO,
                        meus_pontos[6][1] - Y_FRONTAL,           // Comprimento Y
                        3.0                                      // Altura Z
                    ]);

                // 3. Dente Frontal Carmesim
                color("crimson", alpha=0.8)
                translate([
                    0,
                    meus_pontos[4][1],                       // Y recuado
                    3.0                                      // Em cima da base laranja
                ])
                cube([
                    LARGURA_BRACO,
                    meus_pontos[6][1] - meus_pontos[4][1],   // Profundidade Y
                    meus_pontos[5][2] - 3.0                  // Altura Z
                ]);
            }
            
            // Furo do Parafuso da Garra
            translate([hole_x, meus_pontos[4][1] - 1.0, 7.0])
                rotate([-90, 0, 0])
                cylinder(h = 10.0, r = 2.0, $fn=60);
        }
    }

translate([0, 100, 0]) {
    
    // 1. BASE: BLOCO RETANGULAR PRINCIPAL
    color("blue", alpha=0.8)
    translate([meus_pontos[1][0], Y_FRONTAL, meus_pontos[1][2]]) 
        cube([
            meus_pontos[318][0] - meus_pontos[1][0], // Largura (X)
            ESPESSURA,                               // Profundidade (Y)
            meus_pontos[0][2] - meus_pontos[1][2]    // Altura (Z)
        ]);

    // Instanciando o Braço Esquerdo (Ancorado no X do Ponto 1)
    // Furo na esquerda: 7.0mm da borda esquerda
    translate([meus_pontos[1][0], 0, 0]) braco(7.0);

    // Instanciando o Braço Direito (Ancorado no X do Ponto 216)
    // Furo na direita: 7.0mm da borda direita (LARGURA_BRACO - 7.0)
    translate([meus_pontos[216][0], 0, 0]) braco(LARGURA_BRACO - 7.0);

    // 4. Torre Triangular (Com o buraco vazado!)
    difference() {
        
        // A TORRE SÓLIDA (Construída com 'hull' para garantir malha perfeita livre de bugs!)
        color("steelblue", alpha=0.8)
        hull() {
            // Base da Torre (Retângulo maciço de 5mm de espessura)
            translate([meus_pontos[2][0], Y_FRONTAL, meus_pontos[2][2]])
                cube([
                    meus_pontos[319][0] - meus_pontos[2][0], // Largura X
                    ESPESSURA,                               // Profundidade Y (5.0mm)
                    0.01                                     // Altura Z (Quase zero)
                ]);
                
            // Topo da Torre (Linha de 3mm de espessura no cume)
            translate([meus_pontos[165][0] - 0.005, Y_TRASEIRO - 3.0, meus_pontos[165][2]])
                cube([
                    0.01,                                    // Largura X (Ponto central)
                    3.0,                                     // Profundidade Y (3.0mm)
                    0.01                                     // Altura Z
                ]);
        }

        // O BURACO DO VÃO CENTRAL (Usando os novos pontos: 162, 105, 219)
        // Usamos linear_extrude porque polígonos 2D extrudados NUNCA dão erro de geometria manifold no OpenSCAD.
        translate([0, Y_TRASEIRO + 2.0, 0])
        rotate([90, 0, 0])
        linear_extrude(height = ESPESSURA + 4.0) { // +4.0 de espessura de corte (sobra 2mm pra frente e 2mm pra trás)
            polygon(points=[
                [meus_pontos[105][0], 8.0], // Esq Base (Aprofundado para Z=8 para varar o chão sem Z-fighting)
                [meus_pontos[219][0], 8.0], // Dir Base (Aprofundado para Z=8)
                [meus_pontos[162][0], meus_pontos[162][2]] // Topo (Cume do buraco)
            ]);
        }
        
        // FURO DO PARAFUSO DA LUMINÁRIA (Topo)
        translate([meus_pontos[165][0], Y_FRONTAL - 1.0, 83.0])
            rotate([-90, 0, 0])
            cylinder(h = ESPESSURA + 5.0, r = 2.5, $fn=60);
    }

